{
    "name": "cycle/migrations",
    "type": "library",
    "description": "Database migrations, migration scaffolding",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cycle/database": "^2.23",
        "spiral/core": "^3.18",
        "spiral/files": "^3.18",
        "spiral/reactor": "^3.18",
        "spiral/tokenizer": "^3.18"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.20",
        "cycle/testing": "^0.1.1",
        "llm/skills": "^1.20",
        "mockery/mockery": "^1.6",
        "roxblnfk/unpoly": "^1.8",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.60"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/cycle/testing"
        }
    ],
    "autoload": {
        "psr-4": {
            "Cycle\\Migrations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\Migrations\\Tests\\": "tests/",
            "Cycle\\Migrations\\Fixtures\\": "tests/Fixtures/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "db:down": "docker compose -f vendor/cycle/testing/resources/docker/compose.yaml down -v",
        "db:up": "docker compose -f vendor/cycle/testing/resources/docker/compose.yaml up -d --wait",
        "infect": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVERS=sqlite",
            "infection --configuration=infection.json --threads=max"
        ],
        "infect:ci": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVERS=sqlite",
            "infection --ansi --configuration=infection.json --logger-github --threads=max --show-mutations=0"
        ],
        "psalm": "psalm -c vendor-bin/psalm/psalm.xml",
        "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "testo",
        "test:mysql": "testo --suite=Feature/MySQL --suite=Regression/MySQL",
        "test:new-case": "cycle-testing new-case --template=database",
        "test:postgres": "testo --suite=Feature/Postgres --suite=Regression/Postgres",
        "test:sqlite": "testo --suite=Feature/SQLite --suite=Regression/SQLite",
        "test:sqlserver": "testo --suite=Feature/SQLServer --suite=Regression/SQLServer",
        "test:unit": "testo --suite=Unit"
    },
    "scripts-descriptions": {
        "infect": "Run mutation testing with Infection against the Unit and SQLite suites",
        "infect:ci": "Run mutation testing in CI: GitHub annotations, the Stryker dashboard report and the MSI gate",
        "test:new-case": "Generate a regression case for an issue: composer test:new-case -- <issue>"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
