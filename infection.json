{
    "$schema": "vendor-bin/infection/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 10,
    "minMsi": 97,
    "minCoveredMsi": 97,
    "testFramework": "testo",
    "tmpDir": "runtime",
    "logs": {
        "stryker": {
            "report": "4.x"
        }
    },
    "mutators": {
        "@default": true,
        "ReturnRemoval": {
            "ignore": [
                "Cycle\\Migrations\\Migrator::configure"
            ]
        }
    }
}
