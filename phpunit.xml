<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="runtime/phpunit"
         backupGlobals="false"
         backupStaticProperties="false"
         processIsolation="false"
         stopOnFailure="true"
         stopOnError="true"
>
    <source>
        <include>
            <directory>src/</directory>
        </include>
    </source>
    <testsuites>
        <testsuite name="Cycle Database Migrations">
            <directory>./tests/Migrations/MySQL</directory>
            <directory>./tests/Migrations/Postgres</directory>
            <directory>./tests/Migrations/SQLite</directory>
            <directory>./tests/Migrations/SQLServer</directory>
            <directory>./tests/Migrations/Unit</directory>
            <file>./tests/Migrations/ConfigTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
